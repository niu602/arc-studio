# ---- ARC Studio backend environment ----
# Copy to `.env` and adjust as needed. All values have sensible defaults.

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- External ARC compiler ----
COMPILER_PYTHON=F:\hackathon\agentic-requirement-compiler\.venv\Scripts\python.exe
COMPILER_MAIN=F:\hackathon\agentic-requirement-compiler\src\main.py

# Web preview port for the first compiled app (subsequent tasks increment it)
ARC_WEB_PORT_START=3301
ARC_APP_TYPE=web

# Default LLM used by /api/generate-tree when the caller does not supply a key.
# Leave OPENAI_API_KEY empty to use the built-in mock requirement tree.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL=gpt-4o-mini

# Compiler API mode: chat_completions | responses
ARC_OPENAI_API_MODE=chat_completions
